rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdminClaim() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isAdminProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function isAdmin() {
      return isAdminClaim() || isAdminProfile();
    }

    match /users/{userId} {
      // A new user can create only their own profile and cannot self-promote.
      allow create: if isOwner(userId)
        && (!("role" in request.resource.data) || request.resource.data.role == "user");

      // Users can update their own profile, but cannot change role.
      // Existing admins can manage user profiles.
      allow read: if isOwner(userId) || isAdmin();
      allow update: if (isOwner(userId)
        && request.resource.data.role == resource.data.role)
        || isAdmin();
      allow delete: if isAdmin();

      match /{collection}/{documentId} {
        allow read, create, update, delete: if isOwner(userId) || isAdmin();
      }
    }
  }
}
